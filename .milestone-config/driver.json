{
  "integrationBranch": "dev",
  "protectedBranch": "master",
  "parallel": true,
  "sourceGlobs": ["PrayerApp/**", "PrayerApp.Tests/**", "PrayerApp.UITests/**"],
  "uiSurfaceGlobs": ["PrayerApp/**/*.xaml"],
  "unitTestCmd": "dotnet test PrayerApp.Tests/PrayerApp.Tests.csproj",
  "e2eTestCmd": "pwsh ./run-uitests.ps1",
  "implementerAgent": "milestone-driver:implementer",
  "domainSkills": [
    "maui-skills:*",
    "maui-current-apis",
    "prayer-app-accessibility",
    "prayer-app-database",
    "prayer-app-e2e-run",
    "prayer-app-models",
    "prayer-app-navigation",
    "prayer-app-platform",
    "prayer-app-services",
    "prayer-app-theming",
    "prayer-app-ui-testing",
    "prayer-app-unit-testing",
    "prayer-app-viewmodels",
    "prayer-app-views",
    "swiftui-specialist",
    "swiftui-whats-new-27",
    "modernize-tests",
    "audit-xcode-security-settings",
    "app-resizability",
    "app-intents-specialist",
    "app-intents-whats-new-27",
    "accessibility-voiceover-specialist",
    "accessibility-dynamic-type-specialist",
    "accessibility-sufficient-contrast-specialist",
    "xctrace"
  ],
  "nonNegotiables": ["MAUI .NET 10 + Community Toolkit"],
  "e2eEnv": { "endpoint": "127.0.0.1:4723", "device": "Android emulator (AVD)" }
}
