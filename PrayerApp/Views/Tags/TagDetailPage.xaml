<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PrayerApp.ViewModels"
             x:Class="PrayerApp.Views.Tags.TagDetailPage"
             x:DataType="viewModels:TagDetailViewModel"
             Title="Tag"
             SafeAreaEdges="{OnPlatform Android='Container, Container, Container, All', Default=Container}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save"
                     Command="{Binding SaveCommand}"
                     SemanticProperties.Hint="Save tag changes"
                     x:DataType="viewModels:TagDetailViewModel" />
    </ContentPage.ToolbarItems>

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="24">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackgroundTapped" />
            </VerticalStackLayout.GestureRecognizers>

            <!-- System tag note -->
            <Border IsVisible="{Binding IsSystem}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardBorderDark}}"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10">
                <Label Text="This is a system-managed tag. You can change its color, but not its name."
                       FontSize="{StaticResource FontSmall}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondaryDark}}" />
            </Border>

            <!-- Name + Color group (matches #47 chrome pattern) -->
            <Border Style="{StaticResource PrayerCardBorder}" Padding="16">
                <VerticalStackLayout Spacing="24">

            <!-- Name field -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Name" Style="{StaticResource FormLabel}" />
                <Entry x:Name="NameEntry"
                    Text="{Binding Name}"
                    AutomationId="TagDetail_Entry_Name"
                    Placeholder="Tag name"
                    IsReadOnly="{Binding IsSystem}"
                    ReturnType="Done" />
                <BoxView Style="{StaticResource PickerInsetSeparator}" Margin="0,4,0,0" />
            </VerticalStackLayout>

            <!-- Color picker -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Color" Style="{StaticResource FormLabel}" />

                <FlexLayout Wrap="Wrap" Direction="Row"
                            AlignItems="Start" JustifyContent="Start">

                    <!-- Dynamic swatches from UserColor table -->
                    <BindableLayout.ItemsSource>
                        <Binding Path="Swatches" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ColorSwatchViewModel">
                            <Grid WidthRequest="48" HeightRequest="48" Margin="4"
                                  Loaded="OnSwatchLoaded"
                                  SemanticProperties.Description="{Binding LightHex}"
                                  SemanticProperties.Hint="Double tap to select, long press to delete">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                </Grid.GestureRecognizers>
                                <!-- Color circle -->
                                <Ellipse
                                    Fill="{Binding SwatchColor}"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    InputTransparent="True"
                                    AutomationProperties.IsInAccessibleTree="false" />
                                <!-- Selected ring -->
                                <Ellipse
                                    Stroke="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource TextPrimaryDark}}"
                                    StrokeThickness="2"
                                    AutomationProperties.IsInAccessibleTree="false"
                                    Fill="Transparent"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    IsVisible="{Binding IsSelected}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    InputTransparent="True" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Add custom color button — outside FlexLayout (BindableLayout clears static children) -->
                <Grid WidthRequest="48" HeightRequest="48" Margin="4"
                      HorizontalOptions="Start"
                      SemanticProperties.Description="Add custom color"
                      SemanticProperties.Hint="Double tap to open color picker">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddColorCommand}" />
                    </Grid.GestureRecognizers>
                    <Ellipse
                        Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource TextMutedDark}}"
                        StrokeThickness="1.5"
                        StrokeDashArray="4,3"
                        Fill="Transparent"
                        WidthRequest="36"
                        HeightRequest="36"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        AutomationProperties.IsInAccessibleTree="false" />
                    <Label Text="+"
                           FontSize="{StaticResource FontHeading}"
                           FontAttributes="Bold"
                           AutomationProperties.IsInAccessibleTree="false"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource TextSecondaryDark}}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- View prayers with this tag -->
            <Button Text="View Prayers with this Tag"
                    Command="{Binding ViewPrayersCommand}"
                    Style="{StaticResource GhostButton}"
                    IsVisible="{Binding IsExisting}"
                    SemanticProperties.Hint="Navigate to prayer list filtered by this tag"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

    <!-- Save indicator -->
    <ActivityIndicator Style="{StaticResource SaveActivityIndicator}"
                       IsRunning="{Binding IsBusy}"
                       IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
