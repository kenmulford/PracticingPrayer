<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="PrayerApp.Views.Confidential.PinPromptPopup">

    <Border StrokeShape="RoundRectangle 12"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
            Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource CardBorderDark}}"
            WidthRequest="300"
            Padding="16">
        <VerticalStackLayout Spacing="12">

            <Label x:Name="TitleLabel"
                   SemanticProperties.HeadingLevel="Level1"
                   Style="{StaticResource FormLabel}" />

            <Label x:Name="SubtitleLabel"
                   Style="{StaticResource MutedText}" />

            <Entry x:Name="PinEntry"
                   AutomationId="PinPrompt_Entry_Pin"
                   Placeholder="6-digit PIN"
                   MaxLength="6"
                   Keyboard="Numeric"
                   IsPassword="True"
                   SemanticProperties.Hint="Enter a 6-digit PIN"
                   TextChanged="OnPinTextChanged"
                   HorizontalOptions="Fill" />

            <Label x:Name="ErrorLabel"
                   Text="PIN must be exactly 6 digits"
                   TextColor="{StaticResource DangerRed}"
                   Style="{StaticResource MutedText}"
                   IsVisible="False" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Padding="0,4,0,0">
                <Button Grid.Column="0"
                        Text="Cancel"
                        AutomationId="PinPrompt_Btn_Cancel"
                        Style="{StaticResource GhostButton}"
                        Clicked="OnCancel"
                        HorizontalOptions="Fill" />
                <Button x:Name="ConfirmButton"
                        Grid.Column="1"
                        Text="OK"
                        AutomationId="PinPrompt_Btn_Confirm"
                        Clicked="OnConfirm"
                        IsEnabled="False"
                        HorizontalOptions="Fill" />
            </Grid>

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
