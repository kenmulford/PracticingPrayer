<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PrayerApp.ViewModels"
             xmlns:behaviors="clr-namespace:PrayerApp.Behaviors"
             xmlns:shared="clr-namespace:PrayerApp.Views.Shared"
             x:Class="PrayerApp.Views.ConfirmImportPage"
             x:DataType="viewModels:ConfirmImportViewModel"
             Title="Confirm Import">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel"
                     AutomationId="ConfirmImport_Btn_Cancel"
                     Priority="1"
                     x:DataType="viewModels:ConfirmImportViewModel"
                     Command="{Binding CancelCommand}" />
        <ToolbarItem Text="Save"
                     AutomationId="ConfirmImport_Btn_Save"
                     Priority="0"
                     x:DataType="viewModels:ConfirmImportViewModel"
                     Command="{Binding SaveCommand}"
                     SemanticProperties.Hint="Save the imported card and prayers" />
    </ContentPage.ToolbarItems>
    <ScrollView x:Name="RootScroll">
        <ScrollView.Behaviors>
            <behaviors:KeyboardScrollPaddingBehavior />
        </ScrollView.Behaviors>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Collection and Card Selection"
                   Style="{StaticResource FormSectionHeader}"
                   Margin="0,4,0,0" />

            <Border Style="{StaticResource PrayerCardBorder}"
                    Padding="0">
                <VerticalStackLayout Spacing="0">

                    <!-- Row 1: Collection picker (HIG disclosure-row: label intrinsic, value
                         fills remaining width — Settings.app pattern). The earlier `*, Auto`
                         shape sized the picker to its intrinsic min-width (44pt floor from the
                         implicit Picker style) and truncated longer SelectedItem text like
                         "All collections" to "All collecti...". -->
                    <Grid Padding="16,11" ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="Collection"
                               Style="{StaticResource FormLabel}"
                               VerticalOptions="Center" />
                        <shared:StyledPicker Grid.Column="1"
                                             ItemsSource="{Binding AvailableBoxes}"
                                             SelectedItem="{Binding SelectedBox}"
                                             AutomationId="ConfirmImport_Picker_Box"
                                             SemanticHint="Choose which collection this imported card belongs to"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Fill"
                                             HorizontalTextAlignment="End" />
                    </Grid>

                    <BoxView Style="{StaticResource PickerInsetSeparator}" />

                    <!-- Row 2: Add-to segmented control (HIG disclosure-row: label left, control right) -->
                    <Grid Padding="16,11" ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="Add to"
                               Style="{StaticResource FormLabel}"
                               VerticalOptions="Center" />
                        <Grid Grid.Column="1"
                              Padding="3"
                              ColumnDefinitions="Auto, Auto"
                              ColumnSpacing="2"
                              VerticalOptions="Center"
                              HorizontalOptions="End">
                            <!-- New Card tab.
                                 MinimumHeightRequest=44 brings the pill tap-target up to the
                                 Apple HIG / WCAG 2.5.5 44pt floor; the visible 13pt label +
                                 6pt vertical pill padding only reaches ~25pt on its own. -->
                            <Border Grid.Column="0"
                                    AutomationId="ConfirmImport_Seg_NewCard"
                                    Padding="10,6"
                                    MinimumHeightRequest="{StaticResource TouchTargetMinimum}"
                                    MinimumWidthRequest="108"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsNewCardMode}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryBtnDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="New"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       FontSize="{StaticResource FontSmall}"
                                       TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsNewCardMode}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetNewCardModeCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                            <!-- Existing Card tab. Tap-target floor — see New Card tab above. -->
                            <Border Grid.Column="1"
                                    AutomationId="ConfirmImport_Seg_ExistingCard"
                                    Padding="10,6"
                                    MinimumHeightRequest="{StaticResource TouchTargetMinimum}"
                                    MinimumWidthRequest="44"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsExistingCardMode}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryBtnDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Existing"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       FontSize="{StaticResource FontSmall}"
                                       TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExistingCardMode}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetExistingCardModeCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Row 3 (NewCard mode only): Card Title (HIG label-above-field for free-text).
                         Wraps separator + row so the hairline collapses with the field in
                         ExistingCard mode. -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding IsNewCardMode}">
                        <BoxView Style="{StaticResource PickerInsetSeparator}" />
                        <VerticalStackLayout Padding="16,11" Spacing="6">
                            <Label Text="Card Title"
                                   Style="{StaticResource FormLabel}" />
                            <Entry x:Name="CardTitleEntry"
                                   Text="{Binding CardTitle}"
                                   AutomationId="ConfirmImport_Entry_CardTitle"
                                   Placeholder="Card title"
                                   SemanticProperties.Hint="Title for the imported prayer card"
                                   HorizontalOptions="Fill">
                                <Entry.Behaviors>
                                    <behaviors:SelectAllOnFocusBehavior />
                                    <behaviors:KeyboardAvoidanceBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="cardGroupsList"
                                 BindableLayout.ItemsSource="{Binding AvailableCardGroups}"
                                 AutomationId="ConfirmImport_List_Groups"
                                 IsVisible="False"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CardCollectionGroup">
                        <VerticalStackLayout Spacing="0" Margin="0,4,0,10">
                            <Label Text="{Binding CollectionName}"
                                   Style="{StaticResource PickerSectionHeader}"
                                   AutomationId="ConfirmImport_Lbl_GroupHeader"
                                   Margin="4,0,0,6" />
                            <Border Style="{StaticResource PickerGroupCard}">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cards}"
                                                     Spacing="0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:CardPickerItem">
                                            <VerticalStackLayout Spacing="0">
                                                <Border Style="{StaticResource PickerRow}"
                                                        AutomationId="{Binding CardId, StringFormat='ConfirmImport_Item_{0}'}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsLockedVisible}" Value="True">
                                                            <Setter Property="SemanticProperties.Description" Value="Protected card, locked" />
                                                            <Setter Property="SemanticProperties.Hint" Value="Double tap to unlock" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <!-- Lock glyph: same Unicode glyph the Cards tab shows on a masked card. -->
                                                        <Label Grid.Column="0"
                                                               Text="🔒"
                                                               FontSize="{StaticResource FontBody}"
                                                               IsVisible="{Binding IsLockedVisible}"
                                                               AutomationProperties.IsInAccessibleTree="False"
                                                               VerticalOptions="Center"
                                                               Margin="0,0,6,0" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               VerticalOptions="Center"
                                                               TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TextPrimaryDark}}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsLockedVisible}" Value="True">
                                                                    <Setter Property="AutomationProperties.IsInAccessibleTree" Value="False" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label Grid.Column="2"
                                                               Text="&#x2713;"
                                                               IsVisible="False"
                                                               VerticalOptions="Center"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="IsVisible" Value="True" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Grid>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnCardItemTapped" />
                                                    </Border.GestureRecognizers>
                                                </Border>
                                                <BoxView Style="{StaticResource PickerInsetSeparator}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Collapse-on-select summary row: visible after a card is selected.
                 Code-behind manages IsVisible + fade animation in OnVmPropertyChanged. -->
            <Border x:Name="selectedCardSummary"
                    Style="{StaticResource PickerGroupCard}"
                    Padding="16,13"
                    IsVisible="False">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0"
                           Text="{Binding SelectedCard.Title}"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Grid.Column="1"
                           Text="Change"
                           VerticalOptions="Center"
                           FontSize="{StaticResource FontBody}"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChangeCardTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Empty-state for Existing-Card mode when the selected
                 collection has no cards. Without this, the list area is
                 blank and the user reads it as "broken" rather than empty. -->
            <Label x:Name="noCardsLabel"
                   Text="No cards in this collection"
                   AutomationId="ConfirmImport_Lbl_NoCards"
                   IsVisible="{Binding HasNoAvailableCards}"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Italic"
                   Padding="12,16"
                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource TextMutedDark}}" />

            <Label Text="{Binding PrayersHeader}"
                   Style="{StaticResource FormSectionHeader}"
                   SemanticProperties.HeadingLevel="Level2"
                   Margin="0,4,0,0" />

            <Label Text="{Binding AllDuplicatesMessage}"
                   AutomationId="ConfirmImport_Lbl_AllDuplicates"
                   Style="{StaticResource MutedText}"
                   IsVisible="{Binding IsEverythingAlreadyOnCard}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Prayers}"
                                 AutomationId="ConfirmImport_List_Prayers"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:EditablePrayer">
                        <Border Style="{StaticResource PrayerCardBorder}"
                                Padding="8"
                                Margin="0,0,0,6">
                            <VerticalStackLayout Spacing="4">

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="4">
                                    <Entry Text="{Binding Title}"
                                           Placeholder="Prayer title"
                                           AutomationId="ConfirmImport_Entry_PrayerTitle"
                                           SemanticProperties.Description="{Binding TitleAccessibleDescription}"
                                           VerticalOptions="Center"
                                           Loaded="OnPrayerTitleEntryLoaded">
                                        <Entry.Behaviors>
                                            <behaviors:SelectAllOnFocusBehavior />
                                            <behaviors:KeyboardAvoidanceBehavior />
                                        </Entry.Behaviors>
                                    </Entry>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource CloseButton}"
                                            Text="✕"
                                            AutomationId="ConfirmImport_Btn_RemovePrayer"
                                            Clicked="OnRemovePrayerClicked"
                                            SemanticProperties.Description="{Binding RemoveAccessibleDescription}" />
                                </Grid>

                                <!-- "+ details" affordance (#17 / UX-38): a subtle per-row
                                     inline link shown ONLY when the row is collapsed (parser
                                     found no details). Tapping reveals the Editor for this row.
                                     Sibling of the Editor via the InverseBool of the same flag,
                                     so exactly one of the two is visible. Styled in the spirit of
                                     AddPrayerAffordanceButton (transparent bg, Primary text) but
                                     start-aligned and body-sized — a per-row hint, not the
                                     prominent centered "+ Add another prayer ›". -->
                                <HorizontalStackLayout Spacing="8">
                                    <!-- #313: tags a row that "+ Add" moved here from
                                         "Already on this card". -->
                                    <Label Text="Already on this card"
                                           AutomationId="ConfirmImport_Lbl_DuplicateTag"
                                           Style="{StaticResource MutedText}"
                                           FontSize="{StaticResource FontSmall}"
                                           IsVisible="{Binding IsAddedDuplicate}"
                                           VerticalOptions="Center" />
                                    <Button Text="+ details"
                                            AutomationId="ConfirmImport_Btn_AddDetails"
                                            IsVisible="{Binding IsDetailsExpanded, Converter={StaticResource InverseBool}}"
                                            Command="{Binding ExpandDetailsCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                            FontSize="{StaticResource FontSmall}"
                                            Padding="0"
                                            HorizontalOptions="Start"
                                            SemanticProperties.Hint="Show the details field for this prayer" />
                                </HorizontalStackLayout>

                                <Editor Text="{Binding Details}"
                                        Placeholder="Add details..."
                                        IsVisible="{Binding IsDetailsExpanded}"
                                        SemanticProperties.Description="{Binding DetailsAccessibleDescription}"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="{StaticResource TouchTargetMaterial}"
                                        HorizontalOptions="Fill">
                                    <Editor.Behaviors>
                                        <behaviors:KeyboardAvoidanceBehavior />
                                    </Editor.Behaviors>
                                </Editor>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Style="{StaticResource AddPrayerAffordanceButton}"
                    Text="+ Add another prayer ›"
                    AutomationId="ConfirmImport_Btn_AddPrayer"
                    Command="{Binding AddPrayerCommand}" />

            <!-- #313: payload rows already on the selected card. Read-only; "+ Add" moves
                 a row up into To import. Hidden when nothing matches. -->
            <VerticalStackLayout IsVisible="{Binding HasAlreadyOnCard}" Spacing="6">
                <Label Text="{Binding AlreadyOnCardHeader}"
                       AutomationId="ConfirmImport_Lbl_DuplicatesHeader"
                       Style="{StaticResource FormSectionHeader}"
                       SemanticProperties.HeadingLevel="Level2"
                       Margin="0,4,0,0" />
                <Label Text="These won't be added."
                       Style="{StaticResource MutedText}" />
                <Border Style="{StaticResource PickerGroupCard}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AlreadyOnCard}"
                                         AutomationId="ConfirmImport_List_Duplicates"
                                         Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:EditablePrayer">
                                <VerticalStackLayout Spacing="0">
                                    <!-- Padding 16,0: the 48 tall button sets the row height; the
                                         style's default vertical padding would make it 74. -->
                                    <Border Style="{StaticResource PickerRow}" Padding="16,0">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Button Grid.Column="1"
                                                    Text="+ Add"
                                                    AutomationId="ConfirmImport_Btn_AddDuplicate"
                                                    Clicked="OnAddDuplicateClicked"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                    MinimumHeightRequest="{StaticResource TouchTargetMaterial}"
                                                    VerticalOptions="Center"
                                                    SemanticProperties.Description="{Binding AddAccessibleDescription}" />
                                        </Grid>
                                    </Border>
                                    <BoxView Style="{StaticResource PickerInsetSeparator}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
