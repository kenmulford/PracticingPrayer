<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PrayerApp.ViewModels"
             xmlns:shared="clr-namespace:PrayerApp.Views.Shared"
             xmlns:behaviors="clr-namespace:PrayerApp.Behaviors"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="PrayerApp.Views.Prayer.PrayerListPage"
             x:DataType="viewModels:PrayerListViewModel"
             Title="Prayers"
             SafeAreaEdges="Container">
    <ContentPage.ToolbarItems>
        <!-- Single overflow button opens PrayersOverflowPopup (Pray, Add, Show Confidential).
             Mirrors PrayerCardsPage's "More" overflow (issue #298). -->
        <ToolbarItem Text="More" AutomationId="More"
                     IconImageSource="{AppThemeBinding Light=ellipsis_vertical_solid_full.png, Dark=ellipsis_vertical_solid_full_dark.png}"
                     SemanticProperties.Description="More actions"
                     SemanticProperties.Hint="Opens a menu with Pray, Add, and Show Confidential"
                     Clicked="OnOverflowTapped"
                     Order="Primary" Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid x:Name="rootGrid" RowDefinitions="Auto, *">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <!-- Filter controls (sticky above the list) -->
        <VerticalStackLayout Grid.Row="0" Margin="20,16,20,0" Spacing="8">

            <Label Text="Prayer Requests"
                   Style="{StaticResource Headline}" />

            <!-- 3-way status toggle -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="4">

                <Button Text="Active"
                        AutomationId="List_Filter_Active"
                        Command="{Binding SetStatusCommand}"
                        CommandParameter="Active"
                        FontSize="{StaticResource FontSmall}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsActiveSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryBtnDark}}" />
                            <Setter Property="TextColor"       Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsActiveSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonSecondaryLight}, Dark={StaticResource ButtonSecondaryDark}}" />
                            <Setter Property="TextColor"       Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TextPrimaryDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Column="1"
                        Text="Answered"
                        AutomationId="List_Filter_Answered"
                        Command="{Binding SetStatusCommand}"
                        CommandParameter="Answered"
                        FontSize="{StaticResource FontSmall}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAnsweredSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryBtnDark}}" />
                            <Setter Property="TextColor"       Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAnsweredSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonSecondaryLight}, Dark={StaticResource ButtonSecondaryDark}}" />
                            <Setter Property="TextColor"       Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TextPrimaryDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Column="2"
                        Text="All"
                        AutomationId="List_Filter_All"
                        Command="{Binding SetStatusCommand}"
                        CommandParameter="All"
                        FontSize="{StaticResource FontSmall}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAllSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryBtnDark}}" />
                            <Setter Property="TextColor"       Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsAllSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ButtonSecondaryLight}, Dark={StaticResource ButtonSecondaryDark}}" />
                            <Setter Property="TextColor"       Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource TextPrimaryDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </Grid>

            <!-- Search bar -->
            <SearchBar x:Name="searchBar"
                       Text="{Binding SearchText}"
                       AutomationId="List_Search_Prayers"
                       Placeholder="Search prayers..."
                       SearchButtonPressed="OnSearchButtonPressed"
                       ios:SearchBar.SearchBarStyle="Minimal"
                       BackgroundColor="{OnPlatform Default=Transparent, Android={AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource ChipBgDark}}}" />

            <!-- Tag chip row — only shown when tags exist. Horizontal CollectionView
                 so the native control virtualizes the row (BindableLayout does not).
                 No Android HeightRequest: the CollectionView content-sizes, so the
                 chip row grows with font scale; a fixed height re-clips at large
                 scale (issue #48). On iOS a height-unconstrained horizontal
                 CollectionView measures unbounded vertically (dotnet/maui#9135) and
                 fills the page, hiding the list — so ChipStripHeightBehavior bounds
                 it to a single Dynamic-Type-scaled chip row on iOS only (issue #154).
                 Breathing room rides on this Margin rather than the template, since
                 TagFilterChipTemplate is shared by both the Cards and Prayers strips. -->
            <CollectionView ItemTemplate="{StaticResource TagFilterChipTemplate}"
                            ItemsSource="{Binding AvailableTags}"
                            SelectionMode="None"
                            IsVisible="{Binding HasTags}"
                            HorizontalScrollBarVisibility="Never"
                            Margin="0,2,0,6">
                <CollectionView.Behaviors>
                    <behaviors:ChipStripHeightBehavior />
                </CollectionView.Behaviors>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                </CollectionView.ItemsLayout>
            </CollectionView>

        </VerticalStackLayout>

        <!-- Prayer list -->
        <CollectionView
            x:Name="prayerCollection"
            AutomationId="List_List_Prayers"
            AutomationProperties.IsInAccessibleTree="false"
            Grid.Row="1"
            ItemsSource="{Binding FilteredPrayers}"
            Margin="20,0"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,32">
                    <!-- Empty message — IsLoading guard prevents flash during refresh
                         (the LoadingOverlay below covers the spinner role). -->
                    <Label Text="No prayers match your filters."
                           Style="{StaticResource MutedText}"
                           IsVisible="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:PrayerRequestDetailViewModel">
                    <Grid RowDefinitions="Auto, Auto, Auto"
                          Padding="4,10"
                          HorizontalOptions="Fill"
                          SemanticProperties.Description="{Binding AccessibleSummary}"
                          SemanticProperties.Hint="Double tap to view details">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPrayerCommand}" />
                        </Grid.GestureRecognizers>

                        <!-- Card title (small muted) -->
                        <Label Grid.Row="0"
                               Text="{Binding CardTitle}"
                               FontSize="{StaticResource FontTiny}"
                               MaxLines="3"
                               LineBreakMode="TailTruncation"
                               AutomationProperties.IsInAccessibleTree="False"
                               Style="{StaticResource MutedText}" />

                        <!-- Prayer title + answered badge -->
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*, Auto"
                              AutomationProperties.IsInAccessibleTree="False">
                            <Label Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontSize="{StaticResource FontTitle}"
                                   TextColor="{Binding IsAnswered, Converter={StaticResource BoolToMutedColor}}"
                                   TextDecorations="{Binding IsAnswered, Converter={StaticResource BoolToTextDecoration}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding AnsweredAtDisplay}"
                                   Style="{StaticResource SuccessBadge}"
                                   IsVisible="{Binding IsAnswered}"
                                   VerticalOptions="Center"
                                   Margin="6,0,0,0" />
                        </Grid>

                        <!-- Subtle inset separator -->
                        <BoxView Grid.Row="2"
                                 HeightRequest="0.5"
                                 Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                 Opacity="0.4"
                                 Margin="0,8,0,0"
                                 AutomationProperties.IsInAccessibleTree="false" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <shared:LoadingOverlay Grid.Row="0" Grid.RowSpan="2" IsLoading="{Binding IsLoading}" />

    </Grid>

</ContentPage>
